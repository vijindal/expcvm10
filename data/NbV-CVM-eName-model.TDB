
$ Database file for the Nb-V binary CVM extension
$ Unary SGTE data (Nb, V) copied verbatim from cost507.tdb /
$ VZR-re2-CVM-eName-model.TDB, this repo's own existing TDB files.
$
$ CVM parameters (G_CVM lines below): CVCF-basis CECs for the bcc phase,
$ Jindal & Lele, CALPHAD 89 (2025) 102825, Table 17 (Nb-Ti-V-Zr system,
$ Nb-V binary edge):
$   e2NbV1 = 14080   (I-neighbor / 1NN pair)
$   e2NbV2 =  7040   (II-neighbor / 2NN pair)
$   e3NbV  =     0   (triangle)
$   e4NbV  =     0   (tetrahedron)
$ mapped to this repo's e4AB/e3AB/e2AB2/e2AB1 naming (see
$ VZR-re2-CVM-eName-model.TDB's own CEC-identifier comment): e2AB2 is the
$ II-neighbor (2NN) pair CEC, e2AB1 is the I-neighbor (1NN) pair CEC.
$
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT NB   BCC_A2                    9.2906E+01  5.2200E+03  3.6270E+01!
 ELEMENT V    BCC_A2                    5.0941E+01  4.5070E+03  3.0890E+01!


 FUNCTION GHSERNB    2.98150E+02  -8519.353+142.045475*T-26.4711*T*LN(T)
     +2.03475E-04*T**2-3.5012E-07*T**3+93399*T**(-1);  2.75000E+03  Y
      -37669.3+271.720843*T-41.77*T*LN(T)+1.528238E+32*T**(-9);
     6.00000E+03  N !
 FUNCTION GHSERVV    2.98140E+02  -7930.43+133.346053*T-24.134*T*LN(T)
     -.003098*T**2+1.2175E-07*T**3+69460*T**(-1);  7.90000E+02  Y
      -7967.842+143.291093*T-25.9*T*LN(T)+6.25E-05*T**2-6.8E-07*T**3;
     2.18300E+03  Y
      -41689.864+321.140783*T-47.43*T*LN(T)+6.44389E+31*T**(-9);
     4.00000E+03  N !

 FUNCTION UN_ASS 298.15 0; 300 N !

 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT SPECIE 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA !


 TYPE_DEFINITION & GES A_P_D BCC_A2 MAGNETIC  -1.0    4.00000E-01 !
 PHASE BCC_A2  %&  2 1   3 !
    CONSTITUENT BCC_A2  :NB,V : VA :  !

   PARAMETER G(BCC_A2,NB:VA;0)  2.98150E+02  +GHSERNB#;  6.00000E+03  N REF:1 !
   PARAMETER G(BCC_A2,V:VA;0)  2.98140E+02  +GHSERVV#;  4.00000E+03  N REF:1 !
   PARAMETER G(BCC_A2,NB,V:VA;0)  2.98150E+02   0.0;
   6.00000E+03   N   REF:0 !


 $ -------------------------------------------------------------------------
 $ expcvm10 CVM extension: Nb-V / BCC_A2 / T approximation
 $ CEC identifiers follow the CEWorkbench naming convention (see
 $ VZR-re2-CVM-eName-model.TDB):
 $   e4AB   -> CF_0 (v4AB, tetrahedron)
 $   e3AB   -> CF_1 (v3AB, triangle)
 $   e2AB2  -> CF_2 (v2AB2, II-neighbor pair)
 $   e2AB1  -> CF_3 (v2AB1, I-neighbor pair)
 $ Values from Jindal & Lele, CALPHAD 89 (2025) 102825, Table 17.
 $ -------------------------------------------------------------------------

   PARAMETER G_CVM(BCC_A2,NB,V:VA;e4AB)  2.98150E+02  0.0;
   6.00000E+03   N !
   PARAMETER G_CVM(BCC_A2,NB,V:VA;e3AB)  2.98150E+02  0.0;
   6.00000E+03   N !
   PARAMETER G_CVM(BCC_A2,NB,V:VA;e2AB2)  2.98150E+02  7040.0;
   6.00000E+03   N !
   PARAMETER G_CVM(BCC_A2,NB,V:VA;e2AB1)  2.98150E+02  14080.0;
   6.00000E+03   N !

 LIST_OF_REFERENCES
 NUMBER  SOURCE
  !
